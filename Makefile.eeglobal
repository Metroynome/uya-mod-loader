# Shared module entry point and EE build rules, like uya-cheats/rac-cheats.
SHELL := /bin/sh
REGION ?= all

# A module's Makefile only includes this file. The root assigns safe addresses.
ifneq ($(wildcard Makefile.defs),)
.DEFAULT_GOAL := all
.PHONY: all clean
all clean:
	$(MAKE) -C ../.. $@ NAME="$(notdir $(CURDIR))" REGION="$(REGION)"
else

.DEFAULT_GOAL := image
ROOT := $(CURDIR)
WORK := build/$(REGION)
EE_PREFIX ?= ee-
EE_CC := $(EE_PREFIX)gcc
EE_NM := $(EE_PREFIX)nm
EE_OBJCOPY := $(EE_PREFIX)objcopy
REGION_ID_ntscu = 1
REGION_ID_pal = 2
REGION_ID_ntscj = 3
REGION_ID := $(REGION_ID_$(REGION))
REGION_UPPER := $(shell printf '%s' '$(REGION)' | tr a-z A-Z)
LIBRARY ?= none
EE_OBJS ?= main.o
CAMPAIGN_OBJS ?= campaign.o
MULTIPLAYER_OBJS ?= multiplayer.o

ifneq ($(MODULE),)
include $(MODULE)/Makefile.defs
MODULE_NAME := $(notdir $(MODULE))
REGIONS ?= $(if $(filter libuya both,$(LIBRARY)),ntscu pal,ntscu pal ntscj)
MODE ?= $(if $(filter librac3,$(LIBRARY)),campaign,$(if $(filter libuya,$(LIBRARY)),multiplayer,both))
IMAGE ?= $(MODULE_NAME)
IMAGE_LIBRARY := $(LIBRARY)
IMAGE_MODE := $(MODE)
CHECK_OBJS := $(EE_OBJS)
ifeq ($(LIBRARY),both)
CHECK_OBJS := $(CAMPAIGN_OBJS) $(MULTIPLAYER_OBJS)
ifeq ($(IMAGE),$(MODULE_NAME)-campaign)
IMAGE_LIBRARY := librac3
IMAGE_MODE := campaign
EE_OBJS := $(CAMPAIGN_OBJS)
else
IMAGE_LIBRARY := libuya
IMAGE_MODE := multiplayer
EE_OBJS := $(MULTIPLAYER_OBJS)
endif
endif
SOURCE_DIR := $(MODULE)
OBJDIR := $(WORK)/modules/$(IMAGE)
LINKFILE := module.ld
MODE_ID_campaign = 1
MODE_ID_multiplayer = 2
MODE_ID_both = 3
EE_LDFLAGS += -Wl,--defsym,MODULE_ADDRESS=$(ADDRESS),--defsym,MODULE_REGION=$(REGION_ID),--defsym,MODULE_MODES=$(MODE_ID_$(IMAGE_MODE))
else
IMAGE := mod-loader
IMAGE_LIBRARY := none
EE_OBJS := entry.o main.o platform.o strings.o config.o campaign-write.o
SOURCE_DIR := .
OBJDIR := $(WORK)
LINKFILE := loader.ld
endif

# This metadata is generated by Make, not by a second configuration parser.
.PHONY: describe clean-module
clean-module:
	@set -eu; for r in ntscu pal ntscj; do \
	  for n in $(if $(filter both,$(LIBRARY)),$(MODULE_NAME)-campaign $(MODULE_NAME)-multiplayer,$(MODULE_NAME)); do \
	    rm -rf "build/$$r/modules/$$n"; \
	    rm -f "hostfs/uya/mods/$$n.$$r.bin" "build/dist/hostfs/uya/mods/$$n.$$r.bin"; \
	  done; \
	done

describe:
	@set -eu; name='$(MODULE_NAME)'; case "$$name" in ''|[!a-z]*|*[!a-z0-9_-]*) echo 'Invalid module name' >&2; exit 1;; esac; test $${#name} -le 40
	@case '$(LIBRARY):$(MODE)' in none:campaign|none:multiplayer|none:both|librac3:campaign|libuya:multiplayer|both:both) ;; *) echo 'Invalid library/mode in $(MODULE)/Makefile.defs' >&2; exit 1;; esac
	@test -n '$(REGIONS)' && test -n '$(CHECK_OBJS)'
	@set -eu; for r in $(REGIONS); do case "$$r" in ntscu|pal|ntscj) ;; *) echo "Invalid region: $$r" >&2; exit 1;; esac; done; \
	  for obj in $(CHECK_OBJS); do \
	    case "$$obj" in /*|*..*|*[!a-zA-Z0-9_./-]*) echo "Invalid object: $$obj" >&2; exit 1;; esac; \
	    case "$$obj" in *.o) ;; *) exit 1;; esac; \
	    test -f "$(MODULE)/$${obj%.o}.c" || test -f "$(MODULE)/$${obj%.o}.S"; \
	  done
ifeq ($(LIBRARY),both)
	@printf '%s|%s|%s|%s|%s|%s\n' '$(MODULE)' '$(MODULE_NAME)-campaign' librac3 campaign '$(REGIONS)' '$(CAMPAIGN_OBJS)'
	@printf '%s|%s|%s|%s|%s|%s\n' '$(MODULE)' '$(MODULE_NAME)-multiplayer' libuya multiplayer '$(REGIONS)' '$(MULTIPLAYER_OBJS)'
else
	@printf '%s|%s|%s|%s|%s|%s\n' '$(MODULE)' '$(IMAGE)' '$(LIBRARY)' '$(MODE)' '$(REGIONS)' '$(EE_OBJS)'
endif

EE_CFLAGS := -std=gnu99 -Os -fno-inline -G0 -Wall -W -ffreestanding -fno-builtin \
	-fno-pic -mno-abicalls -ffunction-sections -fdata-sections -MMD -MP -D_EE \
	-DUYA_MODULE_REGION=$(REGION_ID) -DUYA_REGION_NAME=\"$(REGION)\" \
	-D$(REGION_UPPER) -DUYA_$(REGION_UPPER) -DRAC3_$(REGION_UPPER) $(EE_CFLAGS)
ifeq ($(REGION),ntscu)
EE_CFLAGS += -DNTSC -DUYA_NTSC -DRAC3_NTSC
endif
EE_INCS := -I. -I$(PS2SDK)/ee/include -I$(PS2SDK)/common/include -I$(WORK)/include $(EE_INCS)
EE_LDFLAGS += -nostdlib -nostartfiles -G0 -Wl,--gc-sections -Wl,-T,$(LINKFILE)
OBJECTS := $(addprefix $(OBJDIR)/,$(EE_OBJS))
ELF := $(OBJDIR)/$(IMAGE).elf
BIN := $(OBJDIR)/$(IMAGE).bin

# Libraries are built in isolated copies; the user's checkouts stay untouched.
LIBRAC3_DIR ?= $(if $(wildcard /opt/uya-mod-loader-deps/librac3),/opt/uya-mod-loader-deps/librac3,../librac3)
LIBUYA_DIR ?= $(if $(wildcard /opt/uya-mod-loader-deps/horizon-uya-patch/libuya),/opt/uya-mod-loader-deps/horizon-uya-patch/libuya,../../Horizon/horizon-uya-patch/libuya)
ifneq ($(IMAGE_LIBRARY),none)
LIB_SOURCE := $(if $(filter librac3,$(IMAGE_LIBRARY)),$(LIBRAC3_DIR),$(LIBUYA_DIR))
LIB_REGION := $(if $(and $(filter libuya,$(IMAGE_LIBRARY)),$(filter ntscu,$(REGION))),ntsc,$(REGION))
LIB_WORK := $(WORK)/libraries/$(IMAGE_LIBRARY)
LIB_ARCHIVE := $(LIB_WORK)/lib/$(IMAGE_LIBRARY)$(LIB_REGION).a
$(LIB_ARCHIVE): $(wildcard $(LIB_SOURCE)/src/* $(LIB_SOURCE)/include/* $(LIB_SOURCE)/Makefile.*)
	@test -f '$(LIB_SOURCE)/Makefile.$(LIB_REGION)' || { echo '$(IMAGE_LIBRARY) has no $(REGION) support' >&2; exit 1; }
	mkdir -p $(LIB_WORK) $(WORK)/include/$(IMAGE_LIBRARY)
	cp -R $(LIB_SOURCE)/include/. $(WORK)/include/$(IMAGE_LIBRARY)/
	(cd $(LIB_SOURCE) && tar --exclude=.git --exclude=obj --exclude=lib --exclude=test -cf - .) | (cd $(LIB_WORK) && tar -xf -)
	$(MAKE) -C $(LIB_WORK) -f Makefile.$(LIB_REGION) clean
	$(MAKE) -C $(LIB_WORK) -f Makefile.$(LIB_REGION) EE_PREFIX=$(EE_PREFIX)
endif

$(OBJDIR)/%.o: $(SOURCE_DIR)/%.c $(LIB_ARCHIVE) Makefile.eeglobal $(wildcard $(MODULE)/Makefile.defs)
	@mkdir -p $(@D)
	$(EE_CC) $(EE_CFLAGS) $(EE_INCS) -c $< -o $@
$(OBJDIR)/%.o: $(SOURCE_DIR)/%.S $(LIB_ARCHIVE) Makefile.eeglobal $(wildcard $(MODULE)/Makefile.defs)
	@mkdir -p $(@D)
	$(EE_CC) $(EE_CFLAGS) $(EE_INCS) -c $< -o $@
-include $(OBJECTS:.o=.d)

# Relink to honor the address selected by the root build, even if objects are unchanged.
.PHONY: image FORCE
$(ELF): $(OBJECTS) $(LIB_ARCHIVE) $(LINKFILE) FORCE
	$(EE_CC) $(EE_LDFLAGS) -Wl,-Map,$(@:.elf=.map) -o $@ $(OBJECTS) $(LIB_ARCHIVE) -lgcc

ifeq ($(MODULE),)
image: $(ELF)
	@set -eu; \
	  payload=$$($(EE_NM) $(ELF) | awk '$$3=="_payload_end" {print "0x"$$1}'); \
	  bss=$$($(EE_NM) $(ELF) | awk '$$3=="_bss_start" {print "0x"$$1}'); \
	  test -n "$$payload" && test "$$payload" = "$$bss" && test $$((payload)) -le $$((0xf2f80))
	$(EE_OBJCOPY) -O binary $(ELF) $(BIN)
	@set -eu; campaign=$$($(EE_NM) $(ELF) | awk '$$3=="campaignEntry" {print "0x"$$1}'); \
	  multiplayer=$$($(EE_NM) $(ELF) | awk '$$3=="multiplayerEntry" {print "0x"$$1}'); \
	  if test '$(REGION)' = ntscj; then multiplayer=; fi; \
	  build/image pnach $(BIN) "$$campaign" $$multiplayer > $(WORK)/publish/loader.pnach
else
image: $(ELF)
	@set -eu; end=$$($(EE_NM) $(ELF) | awk '$$3=="_image_end" {print "0x"$$1}'); \
	  test -n "$$end"; $(EE_OBJCOPY) -O binary --pad-to="$$end" $(ELF) $(BIN)
	build/image module $(BIN) $(REGION_ID) $(ADDRESS) $(RESERVATION) > $(OBJDIR)/size.txt
	cp $(BIN) $(WORK)/publish/$(IMAGE).$(REGION).bin
endif
endif
