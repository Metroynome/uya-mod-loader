# Generated builds and release packages
/build/
# Published release files are tracked; ZIPs and development outputs are not.
/release/**
!/release/README.md
!/release/modules.json
!/release/crcs.json
!/release/files.json
!/release/SC*-*.pnach
!/release/uya/
!/release/uya/maploader-online.txt
!/release/uya/config/
!/release/uya/config/modules.txt
!/release/uya/mods/
!/release/uya/mods/*.bin
!/release/uya/mods/utils/
!/release/uya/mods/utils/mapscan.irx
!/release/uya/mods/utils/exceptionhandler.bin
!/release/horizon_unix_update_cmaps.sh
!/release/horizon_windows_update_cmaps.ps1
bin/
obj/
*.o
*.d
*.elf
*.map
*.a

# Local test sources and results
/test/
/tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Generated regional hostfs modules; keep the optional debug payload
/hostfs/uya/mods/*.bin

# Local custom-map packs and their generated catalogs
/hostfs/uya/*.wad
/hostfs/uya/*.world
/hostfs/uya/*.sound
/hostfs/uya/*.map
/hostfs/uya/*.bg
/hostfs/uya/*.thumb
/hostfs/uya/*.code
/hostfs/uya/*.version
/hostfs/uya/maps.*.idx

# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Local editor, OS, and temporary files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# User-generated per-mod settings
/hostfs/uya/config/*.ini

/release/uya/config/*.ini

/hostfs/uya/mods/utils/mapscan.irx
/hostfs/uya/mods/mapscan.irx
